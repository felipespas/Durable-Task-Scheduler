{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Functions Host (debugpy)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\start-functions-debug.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(?!x)(x)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Azure Functions Core Tools.*$",
          "endsPattern": "^.*Worker process started and initialized\\..*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Wait for debugpy 9091",
      "type": "shell",
      "dependsOn": [
        "Start Functions Host (debugpy)"
      ],
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\wait-debugpy-9091.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start Functions Host and Wait for debugpy",
      "dependsOn": [
        "Wait for debugpy 9091"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Stop Functions Host",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-Process func -ErrorAction SilentlyContinue | Stop-Process -Force"
      ],
      "problemMatcher": []
    }
  ]
}
