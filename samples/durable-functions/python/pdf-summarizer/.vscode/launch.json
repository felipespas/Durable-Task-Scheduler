{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Functions: Start + Attach (One Click)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 9091
      },
      "justMyCode": true,
      "preLaunchTask": "func: host start (debugpy)",
      "postDebugTask": "func: host stop"
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}